# Copier ce fichier en .env et renseigner les valeurs pour l'environnement local.
# Ne JAMAIS committer le fichier .env réel.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_DB=logiflow
POSTGRES_USER=logiflow
POSTGRES_PASSWORD=change-me-local-only
# 5433 (et non 5432) : évite le conflit fréquent avec un PostgreSQL natif déjà installé sur la
# machine (service Windows, Laragon, etc.) qui occupe le port standard.
POSTGRES_PORT=5433

# --- pgAdmin (optionnel, profil local) ---
PGADMIN_DEFAULT_EMAIL=admin@logiflow.local
PGADMIN_DEFAULT_PASSWORD=change-me-local-only
PGADMIN_PORT=5050

# --- Application Spring Boot ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Datasource (doit correspondre aux valeurs Postgres ci-dessus)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=logiflow
DB_USER=logiflow
DB_PASSWORD=change-me-local-only

# --- Keycloak (Docker Compose, service keycloak) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
KEYCLOAK_PORT=8081

# --- Sécurité / OAuth2 resource server ---
# Profil `local` : laisser vides (sécurité permissive + utilisateur fictif).
# Profil `dev` + frontend Keycloak : issuer et JWKS du realm logiflow.
OAUTH2_ISSUER_URI=http://localhost:8081/realms/logiflow
OAUTH2_JWK_SET_URI=http://localhost:8081/realms/logiflow/protocol/openid-connect/certs

# --- MFA (Keycloak/IdP) ---
# true = le backend refuse tout jeton JWT qui ne prouve pas une authentification multi-facteurs
# (claims OIDC `amr`/`acr` du jeton, pas de stockage de code côté backend).
# Voir docs/adr/0002-connexion-mfa-keycloak.md pour la configuration du realm.
MFA_REQUIRED=false
# Méthodes `amr` acceptées comme preuve MFA ("mfa", "otp", "totp", "webauthn"...)
MFA_AMR_METHODS=mfa,otp,totp,webauthn
# Valeurs `acr` acceptées comme preuve MFA (laisser vide = contrôle `amr` seul)
MFA_ACR_VALUES=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Observabilité ---
ACTUATOR_EXPOSE=health,info,metrics,prometheus,modulith

# --- Service IA (application Flask séparée, appelée uniquement par le backend, jamais par Angular) ---
# Voir docs/integration-ia.md
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_API_KEY=change-me-local-only
AI_SERVICE_CONNECT_TIMEOUT=2s
AI_SERVICE_READ_TIMEOUT=8s
