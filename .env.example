# Copier ce fichier en .env et renseigner les valeurs pour l'environnement local.
# Ne JAMAIS committer le fichier .env réel.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_DB=logiflow
POSTGRES_USER=logiflow
POSTGRES_PASSWORD=change-me-local-only
# 5433 (et non 5432) : évite le conflit fréquent avec un PostgreSQL natif déjà installé sur la
# machine (service Windows, Laragon, etc.) qui occupe le port standard.
POSTGRES_PORT=5433

# --- pgAdmin (optionnel, profil local) ---
PGADMIN_DEFAULT_EMAIL=admin@logiflow.local
PGADMIN_DEFAULT_PASSWORD=change-me-local-only
PGADMIN_PORT=5050

# --- Application Spring Boot ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Datasource (doit correspondre aux valeurs Postgres ci-dessus)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=logiflow
DB_USER=logiflow
DB_PASSWORD=change-me-local-only

# --- Sécurité / OAuth2 resource server ---
# URL du realm/issuer JWT (Keycloak ou équivalent). Vide en local si sécurité permissive.
OAUTH2_ISSUER_URI=
OAUTH2_JWK_SET_URI=

# --- MFA (Keycloak/IdP) ---
# true = le backend refuse tout jeton JWT qui ne prouve pas une authentification multi-facteurs
# (claims OIDC `amr`/`acr` du jeton, pas de stockage de code côté backend).
# Voir docs/adr/0002-connexion-mfa-keycloak.md pour la configuration du realm.
MFA_REQUIRED=false
# Méthodes `amr` acceptées comme preuve MFA ("mfa", "otp", "totp", "webauthn"...)
MFA_AMR_METHODS=mfa,otp,totp,webauthn
# Valeurs `acr` acceptées comme preuve MFA (laisser vide = contrôle `amr` seul)
MFA_ACR_VALUES=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Observabilité ---
ACTUATOR_EXPOSE=health,info,metrics,prometheus,modulith

# --- Service IA (application Flask séparée, appelée uniquement par le backend, jamais par Angular) ---
# Voir docs/agents-ia.md (fonctionnement) et docs/integration-ia.md (contrat)
AI_SERVICE_BASE_URL=http://localhost:8000
# Clé Spring -> IA : identique à INTERNAL_API_KEY du service IA
AI_SERVICE_API_KEY=change-me-local-only
# Clé IA -> Spring (outils du copilote) : identique à BACKEND_CALLBACK_API_KEY du service IA,
# et différente de AI_SERVICE_API_KEY
AI_SERVICE_CALLBACK_API_KEY=change-me-local-callback-only
AI_SERVICE_CONNECT_TIMEOUT=2s
# 30 s : la planification et la maintenance appellent un LLM
AI_SERVICE_READ_TIMEOUT=30s
AI_SERVICE_STREAM_READ_TIMEOUT=120s
AI_SERVICE_CONTEXTE_TTL=5m

# --- Agent de maintenance prédictive : déclenchements automatiques ---
AI_MAINTENANCE_ANALYSE_NOCTURNE=true
# Expression cron Spring (secondes minutes heures jour mois jour-semaine), heure de Paris
AI_MAINTENANCE_CRON=0 0 5 * * *
AI_MAINTENANCE_REANALYSE_EVENEMENT=true
AI_MAINTENANCE_HORIZON_JOURS=30

# --- Divers ---
# Stockage disque des documents (pièces jointes)
STORAGE_LOCAL_PATH=./data/uploads
# Moteur de routage pour le tracé des itinéraires sur la carte
OSRM_BASE_URL=https://router.project-osrm.org
